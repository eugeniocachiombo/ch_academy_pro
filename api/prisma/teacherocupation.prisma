model Teacherocupation {
  id             Int @id @default(autoincrement())
  teacher_id     Int
  groupconfig_id Int
  subject_id     Int
  year_id        Int

  teacher     Teacher     @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  groupconfig Groupconfig @relation(fields: [groupconfig_id], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  year        Year        @relation(fields: [year_id], references: [id], onDelete: Cascade)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([teacher_id, groupconfig_id, subject_id, year_id])
}
