model Person {
  id                Int      @id @default(autoincrement())
  firstname         String
  middlename        String?
  lastname          String
  birthday          DateTime @db.Date()
  gender            String
  bi_number         String   @unique
  nif               String?  @unique
  phone             String?
  alternative_phone String?
  email             String?  @unique
  province          String?
  municipality      String?
  neighborhood      String?
  street            String?
  house_number      String?

  users             User[]

  createdAt         DateTime? @default(now())
  updatedAt         DateTime? @updatedAt
}