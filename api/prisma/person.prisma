model Person {
  id         Int      @id @default(autoincrement())
  firstname  String
  middlename String
  lastname   String
  birthday   DateTime @db.Date()
  gender     String
  phone      Int

  user_id Int
  user    User @relation("UserPersons", fields: [user_id], references: [id], onDelete: Cascade)

  // Relação inversa opcional caso o User aponte para Person via person_id
  createdAt      DateTime        @default(now()) 
  updatedAt      DateTime        @updatedAt
  UserAsMain User[]
}
