model RolePermition {
  id           Int       @id @default(autoincrement())
  role_id      Int
  role         Role      @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permition_id Int
  permition    Permition @relation(fields: [permition_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permition_id])
}
