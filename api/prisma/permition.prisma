model Permition {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  editable Boolean? @default(true)

  school_id Int?
  school    School? @relation(fields: [school_id], references: [id])

  createdAt      DateTime?       @default(now())
  updatedAt      DateTime?       @updatedAt
  rolePermitions RolePermition[]
}
