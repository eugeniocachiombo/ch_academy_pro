model Group {
  id   Int    @id @default(autoincrement())
  name String @unique

  school_id Int?
  school    School? @relation(fields: [school_id], references: [id])

  createdAt    DateTime?     @default(now())
  updatedAt    DateTime?     @updatedAt
  groupconfigs Groupconfig[]

  @@unique([name, school_id])
}
