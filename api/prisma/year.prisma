model Year {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  startdate DateTime?
  enddate   DateTime?
  isCurrent Boolean   @default(false)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  groupconfigs      Groupconfig[]
  registers         Register[]
  teacherocupations Teacherocupation[]
}
