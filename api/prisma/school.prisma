model School {
  id                Int       @id @default(autoincrement())
  name              String
  registed_by       Int?
  nif               String?
  alternative_phone String?
  email             String?
  province_id       Int?
  municipality_id   Int?
  created_at        DateTime  @default(now())
  updated_at        DateTime? @updatedAt

  municipality      Municipality?      @relation(fields: [municipalityId], references: [id])
  municipalityId    Int?
  province          Province?          @relation(fields: [provinceId], references: [id])
  provinceId        Int?
  classcourses      Classcourse[]
  courses           Course[]
  groups            Group[]
  groupconfigs      Groupconfig[]
  parents           Parent[]
  periods           Period[]
  permitions        Permition[]
  registers         Register[]
  roles             Role[]
  rooms             Room[]
  students          Student[]
  studentparents    Studentparent[]
  subjectclasses    Subjectclass[]
  teachers          Teacher[]
  teacherocupations Teacherocupation[]
  users             User[]
  userRoles         UserRole[]
  years             Year[]
  periodstudies     Periodstudy[]
  periodtests       Periodtest[]
  presences         Presence[]
  tests             Test[]
  testtypes         Testtype[]
}
