model Test {
  id            Int     @id @default(autoincrement())
  name          String
  school_id     Int
  register_id   Int
  subject_id    Int
  testtype_id   Int
  periodtest_id Int
  year_id       Int
  value         Decimal

  school     School     @relation(fields: [school_id], references: [id])
  register   Register   @relation(fields: [register_id], references: [id])
  subject    Subject    @relation(fields: [subject_id], references: [id])
  periodtest Periodtest @relation(fields: [periodtest_id], references: [id])
  testtype   Testtype   @relation(fields: [testtype_id], references: [id])
  year       Year       @relation(fields: [year_id], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([name, school_id, register_id, subject_id, testtype_id, periodtest_id, year_id])
}
