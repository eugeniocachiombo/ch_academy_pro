model Periodtest {
  id             Int       @id @default(autoincrement())
  name           String    @unique
  school_id      Int
  year_id        Int
  periodstudy_id Int
  startdate      DateTime
  enddate        DateTime?
  testtype_id    Int?

  school      School      @relation(fields: [school_id], references: [id])
  year        Year        @relation(fields: [year_id], references: [id])
  testtype    Testtype?   @relation(fields: [testtype_id], references: [id])
  periodstudy Periodstudy @relation(fields: [periodstudy_id], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  tests     Test[]
}
